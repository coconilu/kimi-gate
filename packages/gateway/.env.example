# kimi-gate gateway 配置示例 —— 复制为 .env 并填入真实值（.env 不提交 git）
PORT=3000
HOST=0.0.0.0
DB_PATH=./kimi-gate.db

# 随机 64 位十六进制（setup 自动生成）
SESSION_SECRET=

# 由 `npm run setup` 生成的 argon2id/scrypt 哈希
ADMIN_PASSWORD_HASH=

# kimi web 本地服务的 bearer token（仅存在于 Gateway）
KIMI_BEARER_TOKEN=

# 上游模式：tunnel = 经 Connector 隧道（kimi 在家里 PC）；local = 同机直连（kimi 跑在本机）
UPSTREAM_MODE=tunnel

# UPSTREAM_MODE=local 时的本地上游地址
# LOCAL_UPSTREAM=http://127.0.0.1:58627

# Connector 配对密钥（setup 自动生成，复制到 connector 配置；仅 tunnel 模式使用）
CONNECTOR_KEY=

# 可选：TOTP 双因素（base32 密钥）
# TOTP_SECRET=

# 位于 Caddy/Nginx 等 TLS 反代之后时保持 true
TRUST_PROXY=true

# 隧道 HTTP 请求超时（毫秒）
# TUNNEL_TIMEOUT_MS=30000

# 经隧道代理的最大请求体（字节）
# MAX_BODY_BYTES=33554432
